---
import Base from '../layouts/Base.astro';
import { pageMeta } from '../data/site';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import BookmarkCard from '../components/BookmarkCard.astro';
import MessagePanel from '../components/MessagePanel.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { bookmarks } from '../data/bookmarks';
---

<Base title={pageMeta.bookmarks.title} description={pageMeta.bookmarks.description} active="bookmarks">
  <Section bottomRule compactRule="bottom" pb={72} gap={48}>
    <PageHeader title="My bookmarks" text="A collection of resources I lean on when I need direction or a spark of inspiration." />
    <div class="bookmark-list">
      {bookmarks.map((bookmark) => (
        <div class="bookmark-list__cell">
          <BookmarkCard {...bookmark} />
        </div>
      ))}
    </div>
  </Section>

  <MessagePanel
    emoji="📮"
    title="Stay connected"
    text="From time to time, I share updates about new work and the ideas shaping my design story. If you’d like to stay connected, you’re welcome to subscribe."
  >
    <NewsletterForm />
  </MessagePanel>
</Base>

<style>
  .bookmark-list {
    display: grid;
    grid-template-columns: repeat(1, minmax(50px, 1fr));
    grid-auto-rows: auto;
    justify-content: center;
    gap: 20px;
    width: 100%;
  }
  .bookmark-list__cell {
    display: flex;
    place-self: start;
    width: 100%;
    min-height: 108px;
  }

  @media (max-width: 999.98px) {
    .bookmark-list {
      gap: 16px;
    }
  }
</style>
