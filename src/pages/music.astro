---
import Base from '../layouts/Base.astro';
import { pageMeta } from '../data/site';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import AlbumCover from '../components/AlbumCover.astro';
import MessagePanel from '../components/MessagePanel.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { albumGroups } from '../data/music';
---

<Base title={pageMeta.music.title} description={pageMeta.music.description} active="music">
  <Section bottomRule compactRule="bottom" pb={72} gap={48}>
    <PageHeader title="My music" text="A set of my favourite songs and the tracks that are shaping my current rotation." />
    {albumGroups.map((group) => (
      <div class="albums">
        <p class="albums__title">{group.title}</p>
        <div class="albums__grid">
          {group.items.map((album) => (
            <div class="albums__cell">
              <AlbumCover {...album} />
            </div>
          ))}
        </div>
      </div>
    ))}
  </Section>

  <MessagePanel
    emoji="📮"
    title="Stay connected"
    text="From time to time, I share updates about new work and the ideas shaping my design story. If you’d like to stay connected, you’re welcome to subscribe."
  >
    <NewsletterForm />
  </MessagePanel>
</Base>

<style>
  .albums {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
  }
  .albums__title {
    width: 322px;
    max-width: 100%;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--text-60);
  }
  .albums__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(50px, 1fr));
    grid-auto-rows: minmax(0, 1fr);
    justify-content: center;
    gap: 32px 86px;
    width: 100%;
    max-width: 90%;
  }
  .albums__cell {
    place-self: start;
    width: 100%;
  }

  @media (max-width: 809.98px) {
    .albums__grid {
      grid-template-columns: repeat(2, minmax(50px, 1fr));
    }
  }
</style>
