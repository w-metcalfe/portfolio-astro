---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import MessagePanel from '../components/MessagePanel.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { site } from '../data/site';
import type { IconName } from '../components/icons';

const contacts: { icon: IconName; label: string; value: string; href: string }[] = [
  { icon: 'email', label: 'Email', value: site.email, href: `mailto:${site.email}` },
  { icon: 'linkedin', label: 'Linkedin', value: '@metcalfewilliam', href: site.linkedinUrl },
];
---

<Base title="Contact - William Metcalfe | UX & Product Designer" active="contact">
  <section class="contact">
    <div class="contact__inner">
      <PageHeader title="Contact me" text="Looking to connect? Send me a message and I’ll get back to you as soon as I can." />
      <div class="contact__form">
        <ContactForm />
      </div>
    </div>
  </section>

  <section class="info">
    <p class="info__title">Contact info</p>
    <ul class="info__list">
      {contacts.map((item) => (
        <li class="info__row">
          <div class="info__label">
            <Icon name={item.icon} size={18} />
            <p>{item.label}</p>
          </div>
          <div class="info__rule" aria-hidden="true" />
          <p class="info__value">
            <a href={item.href} target="_blank" rel="noopener">
              {item.value}
            </a>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <MessagePanel
    emoji="📮"
    title="Stay connected"
    text="From time to time, I share updates about new work and the ideas shaping my design story. If you’d like to stay connected, you’re welcome to subscribe."
  >
    <NewsletterForm />
  </MessagePanel>
</Base>

<style>
  /* Form band: solid rules above and below, dashed side rules on the column */
  .contact {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 20px;
    width: 100%;
    padding: 0 40px;
  }
  .contact::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0 solid var(--border);
    border-width: 1px 0;
    pointer-events: none;
  }
  .contact__inner {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 48px;
    width: 100%;
    max-width: var(--content-width);
    padding: 72px 48px;
  }
  .contact__inner::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0 dashed var(--border);
    border-width: 0 1px;
    pointer-events: none;
  }
  .contact__form {
    position: relative;
    z-index: 4;
    flex: none;
    width: 100%;
  }

  /* Contact details */
  .info {
    position: relative;
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    width: 100%;
    max-width: var(--content-width);
    padding: 72px 48px;
  }
  .info::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 0 dashed var(--border);
    border-width: 0 1px 1px;
    pointer-events: none;
  }
  .info__title {
    position: relative;
    z-index: 2;
    width: 322px;
    max-width: 100%;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--text-60);
  }
  .info__list {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: hidden;
    list-style: none;
  }
  .info__row {
    display: flex;
    flex: none;
    align-items: center;
    width: 100%;
    padding: 12px 0;
    overflow: hidden;
  }
  .info__label {
    display: flex;
    flex: none;
    align-items: center;
    gap: 8px;
    margin-right: 8px;
    color: var(--white);
  }
  .info__label p {
    font-size: 15px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    white-space: pre;
  }
  .info__rule {
    flex: 1 0 0;
    width: 1px;
    height: 1px;
    margin: 0 8px;
    border-top: 1px dashed rgba(255, 255, 255, 0.12);
  }
  .info__value {
    flex: none;
    margin-left: 8px;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    text-align: right;
    color: var(--text-60);
    white-space: pre;
  }
  .info__value a {
    color: inherit;
    text-decoration: none;
    transition: color 0.4s cubic-bezier(0.44, 0, 0.56, 1);
  }
  .info__value a:hover {
    color: var(--white);
    text-decoration: underline;
  }

  @media (max-width: 999.98px) {
    .contact {
      padding: 0;
    }
    .contact__inner {
      max-width: none;
      padding: 72px 40px;
    }
    .contact__inner::after {
      border-width: 1px 0;
    }
    .info {
      max-width: none;
      padding: 72px 40px;
    }
    .info::after {
      display: none;
    }
  }
  @media (max-width: 809.98px) {
    .contact__inner,
    .info {
      max-width: var(--content-width);
      padding: 72px 20px;
    }
  }
</style>
