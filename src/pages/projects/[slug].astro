---
// Case-study pages, one per MDX file in src/content/case-studies (the file name is the slug).
import '../../styles/article.css';
import '../../styles/lightbox.css';
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { projects } from '../../data/projects';
import { site } from '../../data/site';
import imageAlts from '../../data/image-alts.json';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import MessagePanel from '../../components/MessagePanel.astro';
import NewsletterForm from '../../components/NewsletterForm.astro';
import { caseStudyComponents } from '../../components/case-study';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);

// Share image + structured data from the project's card (src/data/projects.ts)
const project = projects.find((p) => p.slug === study.id);
const pageUrl = new URL(`/projects/${study.id}`, site.url).href;
let ogImage: string | undefined;
const ogImageAlt = project ? (imageAlts as Record<string, string>)[project.image.replace(/\.[a-z]+$/, '')] || undefined : undefined;
if (project) {
  const covers = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });
  const cover = covers[`/src/assets/images/${project.image}`]?.default;
  if (cover) ogImage = (await getImage({ src: cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' })).src;
}
const schema = [
  {
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#work`,
    url: pageUrl,
    name: project?.title ?? study.data.title,
    headline: project?.title ?? study.data.title,
    description: study.data.description,
    ...(ogImage && { image: new URL(ogImage, site.url).href }),
    ...(project && { dateCreated: project.timeframe.match(/\d{4}/)?.[0], sourceOrganization: { '@type': 'Organization', name: project.client } }),
    author: { '@id': `${site.url}/#person` },
    isPartOf: { '@id': `${site.url}/#website` },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'Projects', item: `${site.url}/projects` },
      { '@type': 'ListItem', position: 3, name: project?.title ?? study.data.title, item: pageUrl },
    ],
  },
];
---

<Base
  title={study.data.title}
  description={study.data.description}
  active="projects"
  ogImage={ogImage}
  ogImageAlt={ogImage ? ogImageAlt : undefined}
  ogType="article"
  schema={schema}
>
  <Section pb={72} gap={52} bottomRule class="case-study">
    <Content components={caseStudyComponents} />
  </Section>

  <MessagePanel
    emoji="📮"
    title="Stay connected"
    text="From time to time, I share updates about new work and the ideas shaping my design story. If you’d like to stay connected, you’re welcome to subscribe."
  >
    <NewsletterForm />
  </MessagePanel>
</Base>

<script>
  import { initLightbox } from '../../scripts/lightbox';
  initLightbox();
</script>

<style>
  .case-study :global(.section__inner) {
    align-items: center;
  }
</style>
