---
import '../styles/global.css';
import '../styles/springs.css';
import '../styles/motion.css';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import BottomBlur from '../components/BottomBlur.astro';
import { site, type NavKey } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  /** Sidebar item highlighted as current */
  active?: NavKey;
  /** Path used for canonical / og:url, defaults to the current route */
  path?: string;
  noindex?: boolean;
  /** Extra class on <main> for page-level layout tweaks */
  mainClass?: string;
  /** Space reserved for the top bar on tablet/mobile (72px on the home page, 56px elsewhere) */
  compactTop?: number;
  /** Share image (absolute or root-relative URL); defaults to /og-image.jpg */
  ogImage?: string;
  /** Text description of the share image (og:image:alt / twitter:image:alt) */
  ogImageAlt?: string;
  /** og:type; case studies use "article" */
  ogType?: 'website' | 'article';
  /** Extra JSON-LD nodes for this page, added to the site-wide @graph (WebSite + Person) */
  schema?: Record<string, unknown>[];
  /** Set false for full-viewport pages with nothing to scroll to (the gallery canvas) */
  footer?: boolean;
  /** Set false to drop the progressive blur pinned to the bottom of the viewport */
  bottomBlur?: boolean;
}

const {
  title = site.title,
  description = site.description,
  active,
  path = Astro.url.pathname,
  noindex = false,
  mainClass,
  compactTop = 56,
  ogImage: ogImageProp = '/og-image.jpg',
  ogImageAlt = `Memoji-style avatar of ${site.name} above the words “${site.role}” and his name, on a soft peach gradient.`,
  ogType = 'website',
  schema = [],
  footer = true,
  bottomBlur = true,
} = Astro.props;
// Canonical URLs have no trailing slash or .html (as on the original site), whatever the build's URL format
const cleanPath = path
  .replace(/\.html$/, '')
  .replace(/\/index$/, '/')
  .replace(/(.)\/$/, '$1');
const canonical = new URL(cleanPath, site.url).href;
const ogImage = new URL(ogImageProp, site.url).href;
// Structured data: the site and its author on every page, plus any page-specific nodes (case studies)
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${site.url}/#website`, url: `${site.url}/`, name: site.name, publisher: { '@id': `${site.url}/#person` } },
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      jobTitle: site.jobTitle,
      url: `${site.url}/`,
      image: new URL('/apple-touch-icon.png', site.url).href,
      sameAs: [site.linkedinUrl],
      knowsAbout: ['User experience design', 'Product design', 'User research', 'Interaction design', 'Brand design'],
    },
    ...schema,
  ],
};
const { googleAnalyticsId, clarityProjectId } = site.analytics;
const loadAnalytics = import.meta.env.PROD;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="max-image-preview:large" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <!-- Page-specific head tags, e.g. a preload for the page's largest above-the-fold image -->
    <slot name="head" />
    {!noindex && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <link rel="preload" href="/fonts/manrope-500.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-display-500.woff2" as="font" type="font/woff2" crossorigin />
    <!-- Reenie Beanie draws the name in the sidebar, above the fold on every page: preload it to avoid a fallback-font flash -->
    <link rel="preload" href="/fonts/reenie-beanie-400.woff2" as="font" type="font/woff2" crossorigin />
    {loadAnalytics && googleAnalyticsId && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${googleAnalyticsId}`} />
        <script is:inline define:vars={{ googleAnalyticsId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('js', new Date());
          gtag('config', googleAnalyticsId);
        </script>
      </>
    )}
    {loadAnalytics && clarityProjectId && <script is:inline define:vars={{ clarityProjectId }}>
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = 'https://www.clarity.ms/tag/' + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, 'clarity', 'script', clarityProjectId);
    </script>}
  </head>
  <body>
    <div class="page" style={`--compact-top:${compactTop}px`}>
      {bottomBlur && <BottomBlur />}
      <Sidebar active={active} />
      <main class:list={['main', mainClass]}>
        <slot />
        {footer && <Footer />}
      </main>
    </div>
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>

<style>
  .page {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    min-height: 100vh;
    padding-left: var(--sidebar-width);
    background: var(--bg);
  }
  .main {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1 0 0;
    flex-direction: column;
    align-items: center;
    width: 1px;
  }

  @media (max-width: 999.98px) {
    .page {
      flex-direction: column;
      padding: var(--compact-top) 0 0;
      overflow: hidden;
    }
    .main {
      flex: none;
      width: 100%;
    }
  }
</style>
