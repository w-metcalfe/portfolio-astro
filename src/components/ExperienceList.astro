---
// Company · dashed leader · role · years rows.
import Img from './Img.astro';
import type { Experience } from '../data/home';

interface Props {
  items: Experience[];
  /** Only show the first N rows on desktop (tablet and mobile always show all) */
  desktopLimit?: number;
}

const { items, desktopLimit } = Astro.props;
---

<div class="experience">
  {items.map((item, i) => (
    <div class:list={['experience__row', { 'experience__row--extra': desktopLimit !== undefined && i >= desktopLimit }]}>
      <a class="experience__company" href={item.href} target="_blank" rel="noopener">
        <span class="experience__logo">
          <Img src={item.logo} sizes="26px" widths={[52, 78]} />
        </span>
        <span class="experience__name">{item.company}</span>
      </a>
      <span class="experience__leader" aria-hidden="true" />
      <div class="experience__detail">
        <p class="experience__role">{item.role}</p>
        <p class="experience__years">{item.years}</p>
      </div>
    </div>
  ))}
</div>

<style>
  .experience {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 100%;
    overflow: hidden;
  }
  .experience__row {
    display: flex;
    align-items: center;
    gap: 16px;
    width: 100%;
    padding: 12px 0;
    overflow: hidden;
  }
  .experience__company {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    width: min-content;
  }
  .experience__logo {
    position: relative;
    flex: none;
    width: 26px;
    height: 26px;
    border-radius: 72px;
  }
  .experience__name {
    flex: none;
    font-size: 15px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--white);
    white-space: pre;
  }
  .experience__leader {
    position: relative;
    flex: 1 0 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .experience__leader::after {
    content: '';
    position: absolute;
    inset: 0 0 -1px;
    border: 1px dashed rgba(255, 255, 255, 0.12);
  }
  .experience__detail {
    display: flex;
    flex: none;
    justify-content: center;
    align-items: center;
    gap: 16px;
    width: min-content;
  }
  .experience__role {
    flex: none;
    font-size: 15px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--text-70);
    white-space: pre;
  }
  .experience__years {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 400;
    font-size: 15px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    text-align: right;
    color: var(--text-40);
    white-space: pre;
  }

  @media (min-width: 1000px) {
    .experience__row--extra {
      display: none;
    }
  }

  @media (max-width: 809.98px) {
    .experience__detail {
      flex-direction: column;
      justify-content: flex-start;
      align-items: flex-end;
      gap: 6px;
    }
  }
</style>
