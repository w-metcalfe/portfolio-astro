---
// Renders an optimised, responsive image from src/assets/images by file name.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import alts from '../data/image-alts.json';
import focus from '../data/image-focus.json';

interface Props {
  /** File name inside src/assets/images, e.g. "abc123.png" */
  src: string;
  /** Defaults to the alt text recorded in src/data/image-alts.json */
  alt?: string;
  /** CSS sizes attribute; defaults to the content column width */
  sizes?: string;
  /** Candidate widths for the srcset */
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
  fit?: 'cover' | 'contain' | 'fill';
  /** object-position; defaults to the focal point recorded in src/data/image-focus.json, else centre */
  position?: string;
  [key: string]: unknown;
}

const {
  src,
  alt,
  sizes = '(min-width: 1000px) 704px, 100vw',
  widths = [512, 1024, 2048],
  loading = 'lazy',
  class: className,
  fit = 'cover',
  position,
  ...rest
} = Astro.props;

const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/*.{png,jpg,jpeg,webp}', { eager: true });
const entry = files[`/src/assets/images/${src}`];
if (!entry) throw new Error(`Img: missing image "${src}" in src/assets/images`);
const image = entry.default;
// Never upscale: keep the requested widths that fit, or fall back to the original width.
const usable = widths.filter((w) => w <= image.width);
const finalWidths = usable.length ? usable : [image.width];
const fallbackWidth = finalWidths[finalWidths.length - 1];
const focalPoint = position ?? (focus as Record<string, string>)[src] ?? 'center';
const altText = alt ?? (alts as Record<string, string>)[src.replace(/\.[a-z]+$/, '')] ?? '';
---

<Image
  src={image}
  alt={altText}
  width={fallbackWidth}
  height={Math.round((fallbackWidth / image.width) * image.height)}
  widths={finalWidths}
  sizes={sizes}
  loading={loading}
  decoding="async"
  class:list={['img', className]}
  style={`object-fit:${fit};object-position:${focalPoint}`}
  {...rest}
/>

<style>
  .img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: inherit;
  }
</style>
