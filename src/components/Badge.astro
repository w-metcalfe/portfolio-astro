---
// Glossy status pill ("Shipped", "Pitched", "Award").
import type { BadgeColor } from '../data/projects';

interface Props {
  label: string;
  color?: BadgeColor;
}

const { label, color = 'grey' } = Astro.props;
---

<span class:list={['badge', `badge--${color}`]}>{label}</span>

<style>
  .badge {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: min-content;
    padding: 4px 10px;
    overflow: hidden;
    border-radius: 56px;
    background-color: rgb(7, 20, 38);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    box-shadow:
      inset 0 -0.636953px 1.65608px -0.5px rgba(255, 255, 255, 0.267),
      inset 0 -1.9316px 5.02217px -1px rgba(255, 255, 255, 0.275),
      inset 0 -5.10612px 13.2759px -1.5px rgba(255, 255, 255, 0.3),
      inset 0 -16px 41.6px -2px rgba(255, 255, 255, 0.39);
    font-size: 13px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: rgb(255, 255, 255);
    white-space: pre;
  }
  .badge--gold {
    background-color: rgb(61, 49, 9);
  }
  .badge--green {
    background-color: rgb(24, 46, 17);
  }
  .badge--purple {
    background-color: rgb(16, 6, 23);
  }
</style>
