---
// Page title + short intro at the top of inner pages.
interface Props {
  title: string;
  text: string;
  /** Max width of the title in px */
  titleWidth?: number;
  /** Width of the intro paragraph in px */
  textWidth?: number;
}

const { title, text, titleWidth = 480, textWidth = 322 } = Astro.props;
---

<header class="page-header">
  <h1 class="page-header__title" style={`max-width:${titleWidth}px`}>
    {title}
  </h1>
  <p class="page-header__text" style={`width:${textWidth}px`}>
    {text}
  </p>
</header>

<style>
  .page-header {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    width: 100%;
    overflow: hidden;
  }
  .page-header__title {
    width: 100%;
    font-family: var(--font-inter);
    font-weight: 500;
    font-size: 28px;
    line-height: 1.3;
    letter-spacing: -0.03em;
    color: var(--white);
  }
  .page-header__text {
    max-width: 100%;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: -0.01em;
    color: var(--text-60);
  }

  @media (max-width: 999.98px) {
    .page-header__title {
      font-size: 26px;
    }
  }
</style>
